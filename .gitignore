# PhotoSort AI — .gitignore
# ─────────────────────────────────────────────────────────────────────

# ── Storage directories (generated at runtime) ───────────────────────
uploads/
processed/

# ── Model weights and caches (exceeds GitHub file size limits) ────────
models/*
!models/.gitkeep
!models/README.md
!models/download_models.py

# ── Package manager stores ────────────────────────────────────────────
.pnpm-store/
.npm/

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.venv/
venv/
*.db
*.db-wal
*.db-shm
*.sqlite

# ── Environment files ────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Node / Next.js ───────────────────────────────────────────────────
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / Editor ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
