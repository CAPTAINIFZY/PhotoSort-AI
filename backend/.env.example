# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Storage paths ─────────────────────────────────────────────────────────────

# Absolute or relative path where original uploads are stored
UPLOAD_DIR=uploads/originals

# Absolute or relative path where generated thumbnails are stored
THUMBNAIL_DIR=processed/thumbnails

# Directory used by ML frameworks to cache downloaded model weights
MODEL_CACHE_DIR=models

# ── Database ──────────────────────────────────────────────────────────────────

# Path to the SQLite database file
DB_PATH=photosort.db

# ── Upload limits ─────────────────────────────────────────────────────────────

# Maximum accepted file size per image, in megabytes
MAX_FILE_SIZE_MB=25

# Comma-separated list of allowed file extensions (case-insensitive)
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp

# Longest edge (px) for generated thumbnails — aspect ratio is preserved
THUMBNAIL_MAX_DIMENSION=480

# ── CORS ──────────────────────────────────────────────────────────────────────

# Origin of the Next.js frontend (used for CORS allow-list)
FRONTEND_ORIGIN=http://localhost:3000
